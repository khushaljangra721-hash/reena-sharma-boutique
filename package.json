{
  "name": "reena-sharma-boutique",
  "version": "1.0.0",
  "type": "module",
  "description": "Modern Boutique E-Commerce Website for Reena Sharma Boutique with WhatsApp Ordering & Admin Panel",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:all": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/server.js",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
